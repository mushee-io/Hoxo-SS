{
  "version": 2,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/mm-runner",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/mm-runner.js": {
      "maxDuration": 60
    }
  }
}
